<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_confirm_save_model_tree" model="ir.ui.view">
        <field name="name">confirm.save.model.tree</field>
        <field name="model">confirm.save.model</field>
        <field name="arch" type="xml">
            <tree string="Model Save Confirmation">
                <field name="model_id"/>
                <field name="model_name"/>
                <field name="require_confirmation"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_confirm_save_model_form" model="ir.ui.view">
        <field name="name">confirm.save.model.form</field>
        <field name="model">confirm.save.model</field>
        <field name="arch" type="xml">
            <form string="Model Save Confirmation">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                                invisible="active"/>
                    </div>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="model_name" invisible="1"/>
                        </group>
                        <group>
                            <field name="require_confirmation"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <div class="alert alert-info" role="alert">
                            <p><strong>How it works:</strong></p>
                            <ul>
                                <li>When enabled, users will see a confirmation dialog before auto-save</li>
                                <li>This prevents accidental data changes when navigating away</li>
                                <li>Users can choose to save, discard, or cancel the navigation</li>
                            </ul>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_confirm_save_model_search" model="ir.ui.view">
        <field name="name">confirm.save.model.search</field>
        <field name="model">confirm.save.model</field>
        <field name="arch" type="xml">
            <search string="Search Models">
                <field name="model_id"/>
                <field name="model_name"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Requires Confirmation" name="confirmation"
                        domain="[('require_confirmation', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Require Confirmation" name="group_confirmation"
                            context="{'group_by': 'require_confirmation'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_confirm_save_model" model="ir.actions.act_window">
        <field name="name">Model Save Confirmation</field>
        <field name="res_model">confirm.save.model</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure save confirmation for models
            </p>
            <p>
                Add models here to enable save confirmation dialogs when users navigate away with unsaved changes.
            </p>
        </field>
    </record>

    <menuitem id="menu_confirm_save_model"
              name="Model Save Confirmation"
              parent="base.menu_administration"
              action="action_confirm_save_model"
              sequence="100"/>
</odoo>